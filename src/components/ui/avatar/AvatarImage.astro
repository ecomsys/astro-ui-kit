---
import { cn } from "../../../lib/utils";

export interface Props {
  src?: string;
  alt?: string;
  class?: string;
  [key: string]: any;
}

const { src, alt = "", class: className, ...rest } = Astro.props;
---

{
  src ? (
    <img
      data-slot="avatar-image"
      src={src}
      alt={alt}
      class={cn(
        "absolute inset-0 aspect-square size-full rounded-full object-cover",
        className,
      )}
      {...rest}
    />
  ) : null
}
