---
import { cn } from "../../../lib/utils";

export interface Props {
  size?: "default" | "sm" | "lg";
  class?: string;
  [key: string]: any;
}

const { size = "default", class: className, ...rest } = Astro.props;
---

<div
  data-slot="avatar"
  data-size={size}
  class={cn(
    "group/avatar relative flex size-8 shrink-0 items-center justify-center rounded-full select-none after:absolute after:inset-0 after:rounded-full after:border after:border-border after:mix-blend-darken data-[size=lg]:size-10 data-[size=sm]:size-6 dark:after:mix-blend-lighten",
    className,
  )}
  {...rest}
>
  <slot />
</div>
