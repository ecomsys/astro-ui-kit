---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<nav
    role="navigation"
    aria-label="pagination"
    data-slot="pagination"
    class={cn("mx-auto flex w-full justify-center", className)}
    {...rest}
>
    <slot />
</nav>
