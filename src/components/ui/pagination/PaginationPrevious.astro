---
import { cn } from "../../../lib/utils";
import PaginationLink from "./PaginationLink.astro";
import { ChevronLeftIcon } from "@lucide/astro";

export interface Props {
    href?: string;
    isActive?: boolean;
    disabled?: boolean;
    text?: string;
    class?: string;
    [key: string]: any;
}

const { href = "#", isActive = false, disabled = false, text = "Назад", class: className, ...rest } = Astro.props;
---

<PaginationLink
    href={disabled ? undefined : href}
    isActive={isActive}
    size="default"
    aria-label="Go to previous page"
    aria-disabled={disabled ? "true" : undefined}
    class={cn("pl-1.5!", disabled && "pointer-events-none opacity-50", className)}
    {...rest}
>
    <ChevronLeftIcon data-icon="inline-start" />
    <span class="hidden sm:block">{text}</span>
</PaginationLink>
