---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<nav
    class={cn("relative flex max-w-max flex-1 items-center justify-center", className)}
    data-slot="navigation-menu"
    {...rest}
>
    <slot />
</nav>
