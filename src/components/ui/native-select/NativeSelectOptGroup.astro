---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    label?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<optgroup data-slot="native-select-optgroup" class={cn("bg-background text-foreground", className)} {...rest}>
    <slot />
</optgroup>
