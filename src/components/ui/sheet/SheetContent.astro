---
import { cn } from "../../../lib/utils";
import { XIcon } from "@lucide/astro";
import Button from "../Button.astro";

export interface Props {
    side?: "top" | "right" | "bottom" | "left";
    showCloseButton?: boolean;
    class?: string;
    [key: string]: any;
}

const { side = "right", showCloseButton = true, class: className, ...rest } = Astro.props;

const sideClasses = {
    top: "inset-x-0 top-0 h-auto border-b",
    bottom: "inset-x-0 bottom-0 h-auto border-t",
    left: "inset-y-0 left-0 h-full w-3/4 border-r sm:max-w-sm",
    right: "inset-y-0 right-0 h-full w-3/4 border-l sm:max-w-sm",
};

// Классы для начальной и конечной точки анимации (откуда выезжает и куда уезжает)
const enterStart =
    side === "right"
        ? "translate-x-full"
        : side === "left"
          ? "-translate-x-full"
          : side === "top"
            ? "-translate-y-full"
            : "translate-y-full";
const leaveEnd = enterStart;
---

<template x-teleport="body">
    <div x-show="open" x-cloak class="fixed inset-0 z-50">
        <!-- Затемненный фон -->
        <div
            x-show="open"
            x-transition:enter="transition duration-150 ease-out"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition duration-150 ease-in"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            x-on:click="open = false"
            data-slot="sheet-overlay"
            class="fixed inset-0 bg-black/10 supports-backdrop-filter:backdrop-blur-xs"
        >
        </div>

        <!-- Выезжающая панель -->
        <div
            x-show="open"
            x-transition:enter="transition transform duration-200 ease-in-out"
            x-transition:enter-start={enterStart}
            x-transition:enter-end="translate-x-0 translate-y-0"
            x-transition:leave="transition transform duration-200 ease-in-out"
            x-transition:leave-start="translate-x-0 translate-y-0"
            x-transition:leave-end={leaveEnd}
            x-on:click.outside="open = false"
            x-on:keydown.escape.window="open = false"
            data-slot="sheet-content"
            data-side={side}
            class={cn(
                "fixed z-50 flex flex-col gap-4 bg-popover bg-clip-padding text-sm text-popover-foreground shadow-lg outline-none",
                sideClasses[side],
                className,
            )}
            {...rest}
        >
            <slot />

            {
                showCloseButton && (
                    <Button
                        variant="ghost"
                        size="icon-sm"
                        class="absolute top-3 right-3"
                        x-on:click="open = false"
                        aria-label="Close"
                    >
                        <XIcon class="size-4" />
                    </Button>
                )
            }
        </div>
    </div>
</template>
