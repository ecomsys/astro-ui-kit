---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<caption data-slot="table-caption" class={cn("mt-4 text-sm text-muted-foreground", className)} {...rest}>
    <slot />
</caption>
