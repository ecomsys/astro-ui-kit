---
import { cn } from "../../../lib/utils";
export interface Props {
    class?: string;
    [key: string]: any;
}
const { class: className, ...rest } = Astro.props;
---

<div
    x-ref="empty"
    class={cn("py-6 text-center text-sm text-muted-foreground", className)}
    style="display: none;"
    data-slot="command-empty"
    {...rest}
>
    <slot />
</div>
