---
import { cn } from "../../../lib/utils";
export interface Props {
    class?: string;
    [key: string]: any;
}
const { class: className, ...rest } = Astro.props;
---

<span
    class={cn("ml-auto text-xs tracking-widest text-muted-foreground", className)}
    data-slot="command-shortcut"
    {...rest}
>
    <slot />
</span>
