---
import { cn } from "../../../lib/utils";
export interface Props {
    heading?: string;
    class?: string;
    [key: string]: any;
}
const { heading, class: className, ...rest } = Astro.props;
---

<div data-command-group class={cn("p-1", className)} data-slot="command-group" {...rest}>
    {heading && <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground">{heading}</div>}
    <slot />
</div>
