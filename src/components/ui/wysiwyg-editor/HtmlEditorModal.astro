---
import { cn } from "../../../lib/utils";
import Button from "../Button.astro";
import { Wand2 } from "@lucide/astro";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<template x-teleport="body">
    <div
        x-show="isHtmlModalOpen"
        x-cloak
        @keydown.escape.window="closeHtmlModal()"
        class="fixed inset-0 z-[100] flex flex-col items-center overflow-y-auto p-4 sm:pt-[15vh]"
    >
        <div
            x-show="isHtmlModalOpen"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="fixed inset-0 isolate bg-black/50 backdrop-blur-sm"
            @click="closeHtmlModal()"
        >
        </div>

        <div
            x-show="isHtmlModalOpen"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 translate-y-4 scale-95"
            x-transition:enter-end="opacity-100 translate-y-0 scale-100"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0 scale-100"
            x-transition:leave-end="opacity-0 translate-y-4 scale-95"
            class="relative z-10 my-auto w-full max-w-2xl flex flex-col max-h-[80vh] rounded-xl bg-popover text-popover-foreground shadow-2xl ring-1 ring-foreground/10"
        >
            <!-- Шапка модалки (Добавили кнопку Форматировать) -->
            <div class="flex items-center justify-between border-b p-4">
                <h3 class="text-lg font-semibold">Редактирование HTML кода</h3>
                <Button variant="outline" size="sm" @click="formatHtml()">
                    <Wand2 class="size-4" />
                    Форматировать
                </Button>
            </div>

            <!-- Контент -->
            <div class="flex-1 min-h-0 p-4">
                <textarea
                    x-model="modalHtml"
                    class="w-full h-full min-h-[400px] p-4 border rounded-lg bg-muted/50 font-mono text-xs outline-none resize-none focus:outline-none focus:ring-2 focus:ring-ring"
                    placeholder="Здесь raw HTML код..."></textarea>
            </div>

            <!-- Подвал модалки -->
            <div class="flex justify-end gap-2 border-t p-4">
                <Button variant="outline" @click="closeHtmlModal()">Отмена</Button>
                <Button @click="saveHtmlModal()">Сохранить</Button>
            </div>
        </div>
    </div>
</template>
