---
import { cn } from "../../../lib/utils";

export interface Props {
    variant?: "default" | "line";
    class?: string;
    [key: string]: any;
}

const { variant = "default", class: className, ...rest } = Astro.props;

const baseClasses =
    "group/tabs-list inline-flex w-fit items-center justify-center rounded-lg p-[0.25rem] text-muted-foreground group-data-horizontal/tabs:h-8 group-data-vertical/tabs:h-fit group-data-vertical/tabs:flex-col data-[variant=line]:rounded-none";
const variants = {
    default: "bg-muted",
    line: "gap-1 bg-transparent",
};
---

<div data-slot="tabs-list" data-variant={variant} class={cn(baseClasses, variants[variant], className)} {...rest}>
    <slot />
</div>
