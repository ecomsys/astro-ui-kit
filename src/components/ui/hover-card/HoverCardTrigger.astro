---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}
const { class: className, ...rest } = Astro.props;
---

<span
    x-ref="trigger"
    tabindex="0"
    x-on:focus="show()"
    x-on:blur="hide()"
    data-slot="hover-card-trigger"
    class={cn("inline-flex outline-none", className)}
    {...rest}
>
    <slot />
</span>
