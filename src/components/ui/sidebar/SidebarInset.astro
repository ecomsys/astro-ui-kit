---
import { cn } from "../../../lib/utils";
export interface Props {
    class?: string;
    [key: string]: any;
}
const { class: className, ...rest } = Astro.props;
---

<main class={cn("relative flex w-full flex-1 flex-col bg-background", className)} data-slot="sidebar-inset" {...rest}>
    <slot />
</main>
