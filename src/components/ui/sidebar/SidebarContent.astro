---
import { cn } from "../../../lib/utils";
export interface Props {
    class?: string;
    [key: string]: any;
}
const { class: className, ...rest } = Astro.props;
---

<div class={cn("flex min-h-0 flex-1 flex-col gap-0 overflow-auto", className)} data-slot="sidebar-content" {...rest}>
    <slot />
</div>
