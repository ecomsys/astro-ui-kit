---
import { cn } from "../../../lib/utils";
const { class: className, ...rest } = Astro.props;
---

<span
  x-ref="trigger"
  tabindex="0"
  x-on:mouseenter="show()"
  x-on:mouseleave="hide()"
  x-on:focus="show()"
  x-on:blur="hide()"
  class={cn("inline-flex outline-none", className)}
  data-slot="tooltip-trigger"
  {...rest}
>
  <slot />
</span>
