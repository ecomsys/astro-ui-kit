---
import { cn } from "../../../lib/utils";

export interface Props {
    delay?: number;
    side?: "top" | "bottom" | "left" | "right";
    sideOffset?: number;
    class?: string;
    [key: string]: any;
}

const { delay = 100, side = "top", sideOffset = 8, class: className, ...rest } = Astro.props;
---

<div
    x-data={`tooltip(${delay}, '${side}', ${sideOffset})`}
    x-on:keydown.escape.window="hide()"
    class={cn("relative inline-flex", className)}
    data-slot="tooltip"
    {...rest}
>
    <slot />
</div>
