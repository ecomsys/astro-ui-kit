---
import { cn } from "../../lib/utils";

export interface Props {
    ratio: number;
    class?: string;
    [key: string]: any;
}

const { ratio, class: className, ...rest } = Astro.props;
---

<div data-slot="aspect-ratio" style={`--ratio: ${ratio};`} class={cn("relative aspect-(--ratio)", className)} {...rest}>
    <slot />
</div>
