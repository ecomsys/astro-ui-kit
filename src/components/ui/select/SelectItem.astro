---
import { cn } from "../../../lib/utils";
import { CheckIcon } from "@lucide/astro";

export interface Props {
    value: string;
    label: string;
    disabled?: boolean;
    class?: string;
    [key: string]: any;
}

const { value, label, disabled = false, class: className, ...rest } = Astro.props;

const safeValue = value.replace(/'/g, "\\'");
const safeLabel = label.replace(/'/g, "\\'");
---

<button
    type="button"
    x-on:click={`select('${safeValue}', '${safeLabel}')`}
    data-slot="select-item"
    :data-selected={`selectedValue === '${safeValue}'`}
    :aria-selected={`selectedValue === '${safeValue}'`}
    class={cn(
        "relative flex w-full cursor-default items-center gap-1.5 rounded-md py-1 pr-8 pl-1.5 text-sm outline-hidden select-none hover:bg-accent hover:text-accent-foreground data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
        className,
    )}
    disabled={disabled}
    {...rest}
>
    <span class="flex flex-1 shrink-0 gap-2 whitespace-nowrap items-center">
        <slot />
    </span>
    <span class="pointer-events-none absolute right-2 flex size-4 items-center justify-center">
        <CheckIcon x-show={`selectedValue === '${safeValue}'`} class="size-4" />
    </span>
</button>
