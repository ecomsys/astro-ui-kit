---
import { cn } from "../../../lib/utils";
import Button from "../Button.astro";

export interface Props {
    variant?: "default" | "destructive" | "outline" | "secondary" | "ghost" | "link";
    size?: "default" | "sm" | "lg" | "icon" | "icon-xs" | "icon-sm" | "icon-lg";
    class?: string;
    [key: string]: any;
}

const { variant = "ghost", size = "icon-xs", class: className, ...rest } = Astro.props;
---

<Button data-slot="attachment-action" variant={variant} size={size} class={cn(className)} {...rest}>
    <slot />
</Button>
