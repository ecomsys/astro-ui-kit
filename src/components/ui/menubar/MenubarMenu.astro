---
import { cn } from "../../../lib/utils";
export interface Props {
    side?: "top" | "bottom" | "left" | "right";
    align?: "start" | "center" | "end";
    sideOffset?: number;
    class?: string;
    [key: string]: any;
}
const { side = "bottom", align = "start", sideOffset = 4, class: className, ...rest } = Astro.props;
---

<div
    x-data={`menubarMenu('${side}', '${align}', ${sideOffset})`}
    x-on:mouseenter="hoverOpen()"
    class={cn("relative inline-flex w-fit before:absolute before:inset-0 before:z-[-1] before:content-['']", className)}
    data-slot="menubar-menu"
    {...rest}
>
    <slot />
</div>
