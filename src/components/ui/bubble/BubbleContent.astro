---
import { cn } from "../../../lib/utils";

export interface Props {
    href?: string;
    type?: "button" | "submit" | "reset";
    class?: string;
    [key: string]: any;
}

const { href, type = "button", class: className, ...rest } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
    data-slot="bubble-content"
    href={href ? href : undefined}
    type={!href ? type : undefined}
    class={cn(
        "w-fit max-w-full min-w-0 overflow-hidden rounded-xl border border-transparent px-3 py-2 text-sm leading-relaxed break-words group-data-[align=end]/bubble:self-end [button]:text-left [button,a]:transition-colors [button,a]:outline-none [button,a]:focus-visible:border-ring [button,a]:focus-visible:ring-3 [button,a]:focus-visible:ring-ring/50",
        className,
    )}
    {...rest}
>
    <slot />
</Tag>
