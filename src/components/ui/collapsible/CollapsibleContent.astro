---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}
const { class: className, ...rest } = Astro.props;
---

<!-- Внешний блок: ТОЛЬКО анимация высоты -->
<div x-show="open" x-collapse x-cloak data-slot="collapsible-content" class="overflow-hidden" {...rest}>
    <!-- Внутренний блок: ВАШИ КЛАССЫ (паддинги, рамки и т.д.) -->
    <div class={cn("p-0", className)}>
        <slot />
    </div>
</div>
