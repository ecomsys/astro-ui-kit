---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div data-slot="resizable-panel" class={cn("flex-1 min-w-0 min-h-0 overflow-auto", className)} {...rest}>
    <slot />
</div>
