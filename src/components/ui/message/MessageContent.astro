---
import { cn } from "../../../lib/utils";
const { class: className, ...rest } = Astro.props;
---

<div
    data-slot="message-content"
    class={cn(
        "flex w-full min-w-0 flex-col gap-2.5 break-words group-data-[align=end]/message:*:data-slot:self-end",
        className,
    )}
    {...rest}
>
    <slot />
</div>
