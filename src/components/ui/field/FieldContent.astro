---
import { cn } from "../../../lib/utils";
export interface Props {
    class?: string;
    [key: string]: any;
}
const { class: className, ...rest } = Astro.props;
---

<div
    data-slot="field-content"
    class={cn("group/field-content flex flex-1 flex-col gap-0.5 leading-snug", className)}
    {...rest}
>
    <slot />
</div>
