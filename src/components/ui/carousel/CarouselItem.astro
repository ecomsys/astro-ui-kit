---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div
    role="group"
    aria-roledescription="slide"
    data-carousel-item
    class={cn("min-w-0 shrink-0 h-full", className)}
    {...rest}
>
    <slot />
</div>
