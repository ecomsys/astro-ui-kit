---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div class={cn("flex items-center gap-2", className)} data-slot="carousel-pagination" {...rest}>
    <!-- Используем scrollSnapsList -->
    <template x-for="(snap, index) in scrollSnapsList" :key="index">
        <button
            class="size-2.5 rounded-full transition-colors"
            :class="currentIndex === index ? 'bg-primary' : 'bg-muted-foreground/30 hover:bg-muted-foreground/50'"
            x-on:click="goTo(index)"
            :aria-label="`Go to slide ${index + 1}`"></button>
    </template>
</div>
