---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<span
    data-slot="breadcrumb-page"
    role="link"
    aria-disabled="true"
    aria-current="page"
    class={cn("font-normal text-foreground", className)}
    {...rest}
>
    <slot />
</span>
