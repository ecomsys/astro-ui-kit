---
import { cn } from "../../../lib/utils";

export interface Props {
    href?: string;
    class?: string;
    [key: string]: any;
}

const { href, class: className, ...rest } = Astro.props;
---

<a href={href} data-slot="breadcrumb-link" class={cn("transition-colors hover:text-foreground", className)} {...rest}>
    <slot />
</a>
