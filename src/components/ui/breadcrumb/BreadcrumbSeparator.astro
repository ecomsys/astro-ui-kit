---
import { cn } from "../../../lib/utils";
import { ChevronRightIcon } from "@lucide/astro";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<li
    data-slot="breadcrumb-separator"
    role="presentation"
    aria-hidden="true"
    class={cn("[&>svg]:size-3.5", className)}
    {...rest}
>
    <slot>
        <ChevronRightIcon />
    </slot>
</li>
