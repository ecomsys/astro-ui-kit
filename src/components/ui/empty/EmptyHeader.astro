---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div data-slot="empty-header" class={cn("flex max-w-sm flex-col items-center gap-2", className)} {...rest}>
    <slot />
</div>
