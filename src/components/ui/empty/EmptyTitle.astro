---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<h3 data-slot="empty-title" class={cn("font-heading text-sm font-medium tracking-tight", className)} {...rest}>
    <slot />
</h3>
