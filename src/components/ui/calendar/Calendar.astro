---
import { cn } from "../../../lib/utils";
import { ChevronLeftIcon, ChevronRightIcon } from "@lucide/astro";
import Button from "../Button.astro";

export interface Props {
    mode?: "single" | "range";
    class?: string;
    [key: string]: any;
}

const { mode = "single", class: className, ...rest } = Astro.props;

const weekdays = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];
---

<div
    x-data={`calendar('${mode}')`}
    class={cn("group/calendar bg-background p-2 [--cell-size:2.25rem] [--cell-radius:0.5rem]", className)}
    data-slot="calendar"
    {...rest}
>
    <!-- Шапка календаря -->
    <div class="relative flex flex-col gap-4">
        <div class="flex w-full items-center justify-between gap-1">
            <div class="flex h-[var(--cell-size)] items-center font-medium text-sm" x-text="monthTitle"></div>
            <div class="flex items-center gap-1">
                <Button variant="ghost" size="icon" class="size-[var(--cell-size)] p-0" @click="prevMonth()">
                    <ChevronLeftIcon class="size-4" />
                </Button>
                <Button variant="ghost" size="icon" class="size-[var(--cell-size)] p-0" @click="nextMonth()">
                    <ChevronRightIcon class="size-4" />
                </Button>
            </div>
        </div>

        <!-- Дни недели -->
        <div class="flex w-full">
            {
                weekdays.map((day) => (
                    <div class="flex-1 flex h-8 items-center justify-center text-[0.8rem] font-normal text-muted-foreground select-none">
                        {day}
                    </div>
                ))
            }
        </div>

        <!-- Сетка дней -->
        <div class="grid grid-cols-7 w-full">
            <template x-for="day in daysGrid" :key="day.date.getTime()">
                <div
                    class="relative aspect-square h-full w-full p-0 text-center select-none"
                    x-bind:class="{
                        'bg-muted rounded-l-[var(--cell-radius)]': isRangeStart(day.date) && mode === 'range',
                        'bg-muted rounded-r-[var(--cell-radius)]': isRangeEnd(day.date) && mode === 'range',
                        'bg-muted': isInRange(day.date) && !isRangeStart(day.date) && !isRangeEnd(day.date),
                        'rounded-l-[var(--cell-radius)] rounded-r-none': isInRange(day.date) && !isRangeStart(day.date) && !isRangeEnd(day.date),
                    }"
                >
                    <button
                        type="button"
                        @click="selectDate(day.date)"
                        @mouseenter="hoverDate = day.date"
                        @mouseleave="hoverDate = null"
                        class="relative isolate z-10 flex aspect-square size-auto w-full min-w-[var(--cell-size)] flex-col items-center justify-center gap-1 border-0 leading-none font-normal transition-colors rounded-[var(--cell-radius)] outline-none hover:bg-accent hover:text-accent-foreground focus-visible:ring-2 focus-visible:ring-ring"
                        x-bind:class="{
                            'text-muted-foreground opacity-50': day.isOutside,
                            'bg-muted text-foreground': isToday(day.date) && !isSelected(day.date) && !isRangeStart(day.date) && !isRangeEnd(day.date),
                            'bg-primary text-primary-foreground hover:bg-primary hover:text-primary-foreground': isSelected(day.date) || isRangeStart(day.date) || isRangeEnd(day.date),
                            'rounded-none': isInRange(day.date) && !isRangeStart(day.date) && !isRangeEnd(day.date),
                        }"
                    >
                        <span x-text="day.date.getDate()"></span>
                    </button>
                </div>
            </template>
        </div>
    </div>
</div>
