---
import { cn } from "../../../lib/utils";
const { class: className, ...rest } = Astro.props;
---

<span
    tabindex="0"
    role="button"
    x-on:click="open = true"
    x-on:keydown.enter.prevent="open = true"
    data-slot="alert-dialog-trigger"
    class={cn("inline-flex outline-none", className)}
    {...rest}
>
    <slot />
</span>
