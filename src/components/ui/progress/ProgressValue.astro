---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div
    data-slot="progress-value"
    class={cn("ml-auto text-sm text-muted-foreground tabular-nums", className)}
    x-text="value + '%'"
    {...rest}
>
    <slot />
</div>
