---
import { cn } from "../../../lib/utils";

export interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div
    data-slot="progress-indicator"
    class={cn("h-full bg-primary transition-all duration-500 ease-out", className)}
    x-bind:style="'width: ' + value + '%'"
    {...rest}
>
</div>
