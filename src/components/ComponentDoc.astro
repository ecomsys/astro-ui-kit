---
import { Tabs, TabsList, TabsTrigger, TabsContent } from "./ui/tabs";
import Badge from "./ui/Badge.astro";

export interface Props {
    title: string;
    description?: string;
    code: string;
}

const { title, description, code } = Astro.props;
---

<section class="flex flex-col gap-4">
    <div class="flex flex-col gap-2">
        <div class="flex items-center gap-3">
            <h2 class="text-2xl font-bold">{title}</h2>
            <Badge variant="outline">Компонент</Badge>
        </div>
        {description && <p class="text-muted-foreground">{description}</p>}
    </div>

    <Tabs defaultValue="preview">
        <TabsList>
            <TabsTrigger value="preview">Превью</TabsTrigger>
            <TabsTrigger value="code">Код</TabsTrigger>
        </TabsList>

        <TabsContent value="preview" class="mt-4 border rounded-lg p-8">
            <slot />
        </TabsContent>

        <TabsContent value="code" class="mt-4">
            <pre class="bg-muted p-4 rounded-lg overflow-auto text-xs leading-relaxed"><code>{code}</code></pre>
        </TabsContent>
    </Tabs>
</section>
