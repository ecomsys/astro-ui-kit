---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ComponentDoc from "../../components/ComponentDoc.astro";
import {
    ContextMenu,
    ContextMenuTrigger,
    ContextMenuContent,
    ContextMenuItem,
    ContextMenuSeparator,
    ContextMenuCheckboxItem,
    ContextMenuSub,
    ContextMenuSubTrigger,
    ContextMenuSubContent,
    ContextMenuShortcut,
} from "../../components/ui/context-menu";
import { Copy, Scissors, ClipboardPaste, Trash2, FolderInput, Eye, Archive, AlertTriangle } from "@lucide/astro";

// 1. Базовое меню
const basicCode = `import { ContextMenu, ContextMenuTrigger, ContextMenuContent, ContextMenuItem, ContextMenuSeparator, ContextMenuShortcut } from '../../components/ui/context-menu';

<ContextMenu>
  <ContextMenuTrigger class="flex h-32 items-center justify-center rounded-lg border border-dashed text-sm text-muted-foreground">
    Правый клик (Right Click) здесь!
  </ContextMenuTrigger>
  <ContextMenuContent class="w-64">
    <ContextMenuItem>Назад <ContextMenuShortcut>Alt+Left</ContextMenuShortcut></ContextMenuItem>
    <ContextMenuItem disabled>Вперед <ContextMenuShortcut>Alt+Right</ContextMenuShortcut></ContextMenuItem>
    <ContextMenuSeparator />
    <ContextMenuItem>Обновить</ContextMenuItem>
    <ContextMenuSeparator />
    <ContextMenuItem variant="destructive">Удалить <ContextMenuShortcut>Del</ContextMenuShortcut></ContextMenuItem>
  </ContextMenuContent>
</ContextMenu>`;

// 2. Сложное меню (Файл)
const fileCode = `import { ContextMenu, ContextMenuTrigger, ContextMenuContent, ContextMenuItem, ContextMenuSeparator, ContextMenuCheckboxItem, ContextMenuSub, ContextMenuSubTrigger, ContextMenuSubContent } from '../../components/ui/context-menu';
import { Copy, Scissors, ClipboardPaste, Trash2, FolderInput, Eye, Archive, AlertTriangle } from '@lucide/astro';

<ContextMenu>
  <ContextMenuTrigger class="flex h-40 w-full max-w-sm flex-col items-start justify-center rounded-lg border bg-card p-4 text-left">
    <h4 class="text-sm font-medium">Документ.txt</h4>
    <p class="text-xs text-muted-foreground">Правый клик для опций файла</p>
  </ContextMenuTrigger>
  <ContextMenuContent class="w-64">
    <ContextMenuItem><Copy class="size-4" /> Копировать</ContextMenuItem>
    <ContextMenuItem><Scissors class="size-4" /> Вырезать</ContextMenuItem>
    <ContextMenuItem><ClipboardPaste class="size-4" /> Вставить</ContextMenuItem>
    <ContextMenuSeparator />
    
    <!-- Подменю -->
    <ContextMenuSub>
      <ContextMenuSubTrigger><FolderInput class="size-4" /> Переместить в</ContextMenuSubTrigger>
      <ContextMenuSubContent class="w-48">
        <ContextMenuItem><Archive class="size-4" /> Архив</ContextMenuItem>
        <ContextMenuItem variant="destructive"><Trash2 class="size-4" /> Корзина</ContextMenuItem>
      </ContextMenuSubContent>
    </ContextMenuSub>
    
    <ContextMenuSeparator />
    
    <!-- Чекбокс (меню не закроется) -->
    <ContextMenuCheckboxItem><Eye class="size-4" /> Только чтение</ContextMenuCheckboxItem>
    
    <ContextMenuSeparator />
    
    <ContextMenuItem variant="destructive"><AlertTriangle class="size-4" /> Удалить навсегда</ContextMenuItem>
  </ContextMenuContent>
</ContextMenu>`;
---

<DashboardLayout title="Context Menu">
    <div class="flex flex-col gap-10">
        <div class="flex flex-col gap-2">
            <h1 class="text-3xl font-bold tracking-tight">Context Menu</h1>
            <p class="text-muted-foreground text-lg">
                Меню, вызываемое по правому клику мыши. Автоматически позиционируется в точке клика и переворачивается,
                если не хватает места. Поддерживает подменю и чекбоксы.
            </p>
        </div>

        <!-- 1. БАЗОВОЕ МЕНЮ -->
        <ComponentDoc
            title="Базовое меню"
            description="Кликните правой кнопкой мыши по блоку ниже. Меню появится ровно в месте клика."
            code={basicCode}
        >
            <ContextMenu>
                <ContextMenuTrigger
                    class="flex h-32 items-center justify-center rounded-lg border border-dashed text-sm text-muted-foreground w-full max-w-md mx-auto"
                >
                    Правый клик (Right Click) здесь!
                </ContextMenuTrigger>
                <ContextMenuContent class="w-64">
                    <ContextMenuItem>Назад <ContextMenuShortcut>Alt+Left</ContextMenuShortcut></ContextMenuItem>
                    <ContextMenuItem disabled
                        >Вперед <ContextMenuShortcut>Alt+Right</ContextMenuShortcut></ContextMenuItem
                    >
                    <ContextMenuSeparator />
                    <ContextMenuItem>Обновить</ContextMenuItem>
                    <ContextMenuSeparator />
                    <ContextMenuItem variant="destructive"
                        >Удалить <ContextMenuShortcut>Del</ContextMenuShortcut></ContextMenuItem
                    >
                </ContextMenuContent>
            </ContextMenu>
        </ComponentDoc>

        <!-- 2. СЛОЖНОЕ МЕНЮ (ФАЙЛ) -->
        <ComponentDoc
            title="Меню управления файлом"
            description="Реальный кейс. Включает подменю (Переместить в), чекбокс (Только чтение) и опасное действие (Удалить)."
            code={fileCode}
        >
            <ContextMenu>
                <ContextMenuTrigger
                    class="flex h-40 w-full max-w-sm mx-auto flex-col items-start justify-center rounded-lg border bg-card p-4 text-left"
                >
                    <h4 class="text-sm font-medium">Документ.txt</h4>
                    <p class="text-xs text-muted-foreground">Правый клик для опций файла</p>
                </ContextMenuTrigger>
                <ContextMenuContent class="w-64">
                    <ContextMenuItem><Copy class="size-4" /> Копировать</ContextMenuItem>
                    <ContextMenuItem><Scissors class="size-4" /> Вырезать</ContextMenuItem>
                    <ContextMenuItem><ClipboardPaste class="size-4" /> Вставить</ContextMenuItem>
                    <ContextMenuSeparator />

                    <ContextMenuSub>
                        <ContextMenuSubTrigger><FolderInput class="size-4" /> Переместить в</ContextMenuSubTrigger>
                        <ContextMenuSubContent class="w-48">
                            <ContextMenuItem><Archive class="size-4" /> Архив</ContextMenuItem>
                            <ContextMenuItem variant="destructive"><Trash2 class="size-4" /> Корзина</ContextMenuItem>
                        </ContextMenuSubContent>
                    </ContextMenuSub>

                    <ContextMenuSeparator />

                    <ContextMenuCheckboxItem><Eye class="size-4" /> Только чтение</ContextMenuCheckboxItem>

                    <ContextMenuSeparator />

                    <ContextMenuItem variant="destructive"
                        ><AlertTriangle class="size-4" /> Удалить навсегда</ContextMenuItem
                    >
                </ContextMenuContent>
            </ContextMenu>
        </ComponentDoc>
    </div>
</DashboardLayout>
