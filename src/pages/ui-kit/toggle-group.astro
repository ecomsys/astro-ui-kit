---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ComponentDoc from "../../components/ComponentDoc.astro";
import { ToggleGroup, ToggleGroupItem } from "../../components/ui/toggle-group";
import { AlignLeft, AlignCenter, AlignRight, Bold, Italic, Underline } from "@lucide/astro";

// Теперь код 1 в 1 совпадает с превью
const singleCode = `import { ToggleGroup, ToggleGroupItem } from '../../components/ui/toggle-group';

<ToggleGroup type="single" defaultValue="center" class="p-1 rounded-lg border">
  <ToggleGroupItem value="left">Слева</ToggleGroupItem>
  <ToggleGroupItem value="center">По центру</ToggleGroupItem>
  <ToggleGroupItem value="right">Справа</ToggleGroupItem>
</ToggleGroup>`;

const multipleCode = `import { ToggleGroup, ToggleGroupItem } from '../../components/ui/toggle-group';
import { Bold, Italic, Underline } from '@lucide/astro';

<ToggleGroup type="multiple" defaultValue={['bold', 'italic']} class="p-1 rounded-lg border">
  <ToggleGroupItem value="bold" aria-label="Toggle bold"><Bold class="size-4" /></ToggleGroupItem>
  <ToggleGroupItem value="italic" aria-label="Toggle italic"><Italic class="size-4" /></ToggleGroupItem>
  <ToggleGroupItem value="underline" aria-label="Toggle underline"><Underline class="size-4" /></ToggleGroupItem>
</ToggleGroup>`;

const outlineCode = `import { ToggleGroup, ToggleGroupItem } from '../../components/ui/toggle-group';
import { AlignLeft, AlignCenter, AlignRight } from '@lucide/astro';

<ToggleGroup type="single" variant="outline" defaultValue="left">
  <ToggleGroupItem value="left" aria-label="Align left"><AlignLeft class="size-4" /></ToggleGroupItem>
  <ToggleGroupItem value="center" aria-label="Align center"><AlignCenter class="size-4" /></ToggleGroupItem>
  <ToggleGroupItem value="right" aria-label="Align right"><AlignRight class="size-4" /></ToggleGroupItem>
</ToggleGroup>`;
---

<DashboardLayout title="Toggle Group">
    <div class="flex flex-col gap-10">
        <!-- Заголовок страницы -->
        <div class="flex flex-col gap-2">
            <h1 class="text-3xl font-bold tracking-tight">Toggle Group</h1>
            <p class="text-muted-foreground text-lg">
                Группа кнопок-переключателей. В режиме type="single" работает как радио-кнопки (только один активный), в
                type="multiple" — как чекбоксы (можно выбрать несколько).
            </p>
        </div>

        <!-- 1. ОДИНОЧНЫЙ ВЫБОР (SINGLE) -->
        <ComponentDoc
            title="Одиночный выбор (Single)"
            description="type='single' позволяет выбрать только один вариант. Используйте defaultValue для предвыбора."
            code={singleCode}
        >
            <div class="flex justify-center py-8">
                <ToggleGroup type="single" defaultValue="center" class="p-1 rounded-lg border">
                    <ToggleGroupItem value="left">Слева</ToggleGroupItem>
                    <ToggleGroupItem value="center">По центру</ToggleGroupItem>
                    <ToggleGroupItem value="right">Справа</ToggleGroupItem>
                </ToggleGroup>
            </div>
        </ComponentDoc>

        <!-- 2. МНОЖЕСТВЕННЫЙ ВЫБОР (MULTIPLE) -->
        <ComponentDoc
            title="Множественный выбор (Multiple)"
            description="type='multiple' позволяет нажать несколько кнопок сразу. defaultValue принимает массив строк."
            code={multipleCode}
        >
            <div class="flex justify-center py-8">
                <ToggleGroup type="multiple" defaultValue={["bold", "italic"]} class="p-1 rounded-lg border">
                    <ToggleGroupItem value="bold" aria-label="Toggle bold"><Bold class="size-4" /></ToggleGroupItem>
                    <ToggleGroupItem value="italic" aria-label="Toggle italic"
                        ><Italic class="size-4" /></ToggleGroupItem
                    >
                    <ToggleGroupItem value="underline" aria-label="Toggle underline"
                        ><Underline class="size-4" /></ToggleGroupItem
                    >
                </ToggleGroup>
            </div>
        </ComponentDoc>

        <!-- 3. С ОБВОДКОЙ (OUTLINE) -->
        <ComponentDoc
            title="С обводкой (Outline)"
            description="Передайте variant='outline' в саму группу, и все кнопки внутри получат рамку."
            code={outlineCode}
        >
            <div class="flex justify-center py-8">
                <ToggleGroup type="single" variant="outline" defaultValue="left">
                    <ToggleGroupItem value="left" aria-label="Align left"><AlignLeft class="size-4" /></ToggleGroupItem>
                    <ToggleGroupItem value="center" aria-label="Align center"
                        ><AlignCenter class="size-4" /></ToggleGroupItem
                    >
                    <ToggleGroupItem value="right" aria-label="Align right"
                        ><AlignRight class="size-4" /></ToggleGroupItem
                    >
                </ToggleGroup>
            </div>
        </ComponentDoc>
    </div>
</DashboardLayout>
